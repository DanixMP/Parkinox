# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DB_NAME=parkinox
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Parking Configuration
PARKING_CAPACITY=100

# Email Configuration (Production)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password

# Detection-fail ingest (Core -> Django)
DETECTION_FAIL_INGEST_TOKEN=dev-fail-ingest-token

# Cloud reporting replica sync (disabled by default)
CLOUD_SYNC_ENABLED=true
CLOUD_BASE_URL=https://admin.parkinox.ir
CLOUD_SITE_ID=pilot-main
CLOUD_SITE_INGEST_TOKEN=admin123
SUCCESS_CAPTURE_ENABLED=true
SUCCESS_CAPTURE_FASTAPI_URL=http://127.0.0.1:8002
